# =============================================================================
# GoTogether Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables for your target environment:
#   cp .env.example .env

# Server & Network Configuration
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Authentication & Security
# Replace with a strong random secret in staging & production environments
JWT_SECRET="gotogether_jwt_super_secret_production_key_change_me"

# -----------------------------------------------------------------------------
# Database Configuration (Prisma)
# -----------------------------------------------------------------------------
# Production Database: PostgreSQL
# Compatible with Neon, Supabase, Railway, AWS RDS, Render, and Azure PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA&sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_password@db.xyzcompany.supabase.co:5432/postgres?schema=public&sslmode=require"

# Local Development Alternative (SQLite):
# If developing locally with SQLite, use prisma/schema.sqlite.prisma:
# DATABASE_URL="file:./dev.db"
